{
  "name": "aronexa-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && npm test && npm run build:previews",
    "test:reception": "node --experimental-strip-types --test test/reception-demo.test.mjs",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "build:previews": "vite build --config vite.consultation.config.ts && vite build --config vite.smart-rx.config.ts && vite build --config vite.billing.config.ts",
    "dev:connected:test": "vite --config vite.connected-reception.config.ts",
    "build:connected:test": "tsc --noEmit && vite build --config vite.connected-reception.config.ts",
    "dev:connected:doctor:test": "vite --config vite.connected-doctor.config.ts",
    "build:connected:doctor:test": "tsc --noEmit && vite build --config vite.connected-doctor.config.ts"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
